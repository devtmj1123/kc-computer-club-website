# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="KC Computer Club"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Supabase (target backend)
# Project settings → API
# New keys start with sb_publishable_ / sb_secret_.
# Legacy anon / service_role keys also work.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ─────────────────────────────────────────────────────────────
# Session / token signing (server-only, at least 32 random chars each)
# Generate with: openssl rand -base64 48
# ─────────────────────────────────────────────────────────────
ADMIN_SESSION_SECRET=""
STUDENT_SESSION_SECRET=""
RESET_TOKEN_SECRET=""

# ─────────────────────────────────────────────────────────────
# Email (password reset)
# SMTP is the default and recommended option. Set SMTP_HOST and
# SMTP_FROM_EMAIL (plus SMTP_USER / SMTP_PASS if your server needs
# authentication). SMTP_FROM_EMAIL defaults to SMTP_USER.
# Port 587 uses STARTTLS; port 465 sets SMTP_SECURE automatically.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="KC Computer Club"

# Optional alternative: Resend. Ignored when SMTP is configured.
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL=""

# ─────────────────────────────────────────────────────────────
# reCAPTCHA v3 (public forms: comments + anonymous signups)
# If RECAPTCHA_SECRET_KEY is empty, verification is skipped in development.
# Set it in production.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────
# First admin bootstrap (run once with npm run bootstrap:supabase)
# Remove BOOTSTRAP_ADMIN_PASSWORD from .env.local afterwards.
# ─────────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Optional: Instagram notice import via Facebook oEmbed.
FACEBOOK_OEMBED_TOKEN=""

